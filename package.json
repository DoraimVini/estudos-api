{
  "name": "estudos-api",
  "version": "0.6.0",
  "description": "API REST para organizar meus estudos de dev full stack, a partir do plano de 3 anos",
  "type": "module",
  "main": "src/server.ts",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.ts",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "node --no-warnings=ExperimentalWarning src/db/reset.ts",
    "plano": "node src/scripts/gerar-plano.ts",
    "exercicio": "node --no-warnings=ExperimentalWarning src/scripts/exercicio.ts",
    "links": "node src/scripts/verificar-links.ts",
    "planilha": "node --no-warnings=ExperimentalWarning src/scripts/planilha.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "fflate": "0.8.2",
    "marked": "18.0.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "supertest": "^7.1.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  }
}
