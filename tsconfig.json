{
  // Só checagem de tipos: quem roda o código é o próprio Node (type stripping), sem build.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // O Node apaga os tipos e roda o .ts direto; por isso os imports usam a extensão .ts...
    "allowImportingTsExtensions": true,
    // ...e só vale sintaxe que dá para apagar (sem enum, namespace ou parameter properties).
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
